# ==========================================
# Aspectra ABSA — Git Ignore Rules
# ==========================================

# 1. Python Environment & Cache
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# 2. Node.js & Frontend Dependencies
node_modules/
frontend/node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# (Note: frontend/dist is retained so the compiled UI works out-of-the-box)

# 3. Large Model Checkpoints (> 100MB exceeds GitHub push limit)
# GitHub enforces a 100MB strict file size limit. Trained weights are ~255MB each.
*.pt
*.bin
*.safetensors
*.onnx
models/aspect_extraction/distilbert/*.pt
models/sentiment_classification/distilbert/*.pt
models/aspect_extraction/bilstm/*.pt
models/sentiment_classification/bilstm/*.pt

# 4. Logs, Temporary & Extra Documentation Files
logs/*.log
*.log
*.tmp
*.bak
.env
.env.local
.DS_Store
Thumbs.db
desktop.ini

# Extra internal viva guides & auxiliary presentations not needed on public GitHub repo
VIVA_MASTER_GUIDE.txt
PPT_10_SLIDES.md
PRESENTATION_GUIDE.md
DEPLOYMENT_GUIDE.md
README_DOCKER.md
project_viva_documentation/

# 5. IDE / Editor Folders
.vscode/
.idea/
*.swp
*.swo
